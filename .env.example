# Copy to .env (mode 600) or let install.sh generate it.

# Database the web UI reads and writes. This account is deliberately narrow:
# read/write on the user and group tables, read-only on accounting history.
DB_HOST=127.0.0.1
DB_NAME=radius
DB_USER=radweb
DB_PASS=

# Signs session cookies. Must stay stable across restarts or everyone is
# signed out on every restart. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Sign-in for the web UI itself. Not a RADIUS account.
# Generate the hash with:
#   python3 -c "from werkzeug.security import generate_password_hash as h; print(h('yourpassword'))"
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Optional: override where the privileged domain-join helper lives.
# HELPER_PATH=/opt/freeradius-manager/deploy/radmgr-helper
